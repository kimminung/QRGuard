      }
    },
    "abuse.ch URLhaus에 주소 원문을 보내 악성 파일 배포지인지 확인해요. 기본 꺼짐." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends the raw address to abuse.ch URLhaus to check whether it distributes malicious files. Off by default."
          }
        }
      }
    },
    "bit.ly 같은 단축 주소는 어디로 가는지 숨겨요. QR Guard가 쿠키 없이 끝까지 따라가 보여드려요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short links like bit.ly hide where they lead. QR Guard follows them to the end without cookies and shows you the destination."
          }
        }
      }
    },
    "Google Safe Browsing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Safe Browsing"
          }
        }
      }
    },
    "Google Safe Browsing에 주소 원문이 아닌 짧은 암호화 조각(해시 앞 4바이트)만 보내 악성 여부를 확인해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks for malicious sites by sending Google Safe Browsing only a short hashed fragment (the first 4 bytes of a hash), never the raw address."
          }
        }
      }
    },
    "https://… 또는 문자 내용" : {
      "localizations" : {
