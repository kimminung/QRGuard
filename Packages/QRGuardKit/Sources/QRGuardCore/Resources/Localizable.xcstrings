    },
    "rule.V01.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code could not be read from a single image and only decoded after combining neighboring images. Splitting a QR code into pieces is a known way to slip past security filters."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 장만으로는 읽히지 않고 옆 이미지와 합쳐야 읽히는 코드예요. 보안 필터를 피하려고 QR을 여러 조각으로 나누는 수법이 알려져 있어요."
          }
        }
      }
    },
