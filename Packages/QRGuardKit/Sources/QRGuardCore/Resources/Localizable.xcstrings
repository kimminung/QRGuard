        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you received a QR code in pieces by email or message, do not open it; confirm with the sender another way."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일·메시지로 조각난 QR을 받았다면 열지 말고, 보낸 사람에게 다른 방법으로 확인하세요."
          }
